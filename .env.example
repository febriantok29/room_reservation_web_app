APP_NAME=RapaTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE_USER=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=room_reservation_web_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log

# Firebase / FCM (Push Notifications)
# Unduh service account dari: Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS=storage/app/firebase-service-account.json

VITE_APP_NAME="${APP_NAME}"

# Password bypass untuk login cepat saat APP_DEBUG=true.
# HARUS DIKOSONGKAN di production/pre-live agar tidak aktif.
BYPASS_PASSWORD=

# Generate dengan: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
