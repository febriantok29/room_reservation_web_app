                {
                    "name": "Refresh Token - Valid",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    var currentRole = pm.collectionVariables.get('current_role');",
                                    "    pm.collectionVariables.set('current_access_token', jsonData.data.access_token);",
                                    "    if (currentRole === 'admin') pm.collectionVariables.set('admin_access_token', jsonData.data.access_token);",
                                    "    if (currentRole === 'staff') pm.collectionVariables.set('staff_access_token', jsonData.data.access_token);",
                                    "    if (currentRole === 'user') pm.collectionVariables.set('user_access_token', jsonData.data.access_token);",
                                    "    console.log('✅ Token refresh berhasil!');",
                                    "    console.log('New Access Token expires in:', jsonData.data.expires_in, 'seconds');",
                                    "} else {",
                                    "    console.log('❌ Token refresh gagal:', pm.response.json());",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"refresh_token\": \"{{current_refresh_token}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/refresh",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
