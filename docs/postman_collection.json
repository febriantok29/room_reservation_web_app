                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    pm.collectionVariables.unset('current_access_token');",
                                    "    pm.collectionVariables.unset('current_refresh_token');",
                                    "    pm.collectionVariables.unset('current_role');",
                                    "    console.log('✅ Current session token dibersihkan dari collection variables');",
                                    "}"
                                ]
                            }
                        }
                    ],
