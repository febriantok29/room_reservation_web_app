                    "key": "format",
                    "value": "json",
                    "description": "Output format: json | pdf | excel"
                },
                {
                    "key": "period",
                    "value": "monthly",
                    "description": "Grouping period: daily | weekly | monthly (default: monthly)"
                },
                {
                    "key": "year",
                    "value": "2026",
                    "description": "Year (2000-2100). Default: current year"
                },
                {
                    "key": "month",
                    "value": "3",
                    "description": "Month (1-12). Only used when period=daily. Default: current month"
                }
            ]
        },
        "description": "**Output 8** — Periodic Reservation Summary. Groups reservations by day/week/month and shows counts by status. Admin recommended."
    },
