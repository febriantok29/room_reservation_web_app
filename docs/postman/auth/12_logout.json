{
    "name": "Logout",
    "request": {
        "method": "POST",
        "header": [
            {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
            }
        ],
        "url": {
            "raw": "{{base_url}}/api/v1/auth/logout",
            "host": [
                "{{base_url}}"
            ],
            "path": [
                "api",
                "v1",
                "auth",
                "logout"
            ]
        }
    },
    "response": [
        {
            "name": "Example ✅ 200 OK",
            "originalRequest": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{access_token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/auth/logout",
